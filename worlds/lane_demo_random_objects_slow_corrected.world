    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>16.2105 -9.49121 5.05092 0 0.275643 2.35619</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>   
      </camera>
    </gui>
    <!-- 3) The “vehicle” is still a 0.2×0.2×0.2 blue box,
          but now it carries a DVS sensor on its front. -->
    <model name="camera_model">
      <static>false</static> <!-- ✅ Add this to make the model movable -->
      <pose>0 0 1.0 0 0 0</pose>

      <link name="link">
        <pose>0 0 0 0 0 0</pose>

        <!-- ✅ Add inertial properties -->
        <inertial>
          <mass>1.0</mass>
          <inertia>
            <ixx>0.001</ixx>
            <iyy>0.001</iyy>
            <izz>0.001</izz>
            <ixy>0.0</ixy>
            <ixz>0.0</ixz>
            <iyz>0.0</iyz>
          </inertia>
        </inertial>

        <collision name="collision">
          <geometry>
            <box>
              <size>0.2 0.2 0.2</size>
            </box>
          </geometry>
        </collision>

        <visual name="vis">
          <geometry>
            <box>
              <size>0.2 0.2 0.2</size>
            </box>
          </geometry>
          <material>
            <ambient>0 0 1 1</ambient>
            <diffuse>0 0 1 1</diffuse>
          </material>
        </visual>

        <sensor name="dvs_cam" type="camera">
          <pose>0 0 0 0 0 0</pose>
          <camera name="__default__">
            <horizontal_fov>1.047</horizontal_fov>
            <image>
              <width>128</width>
              <height>128</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>100</far>
            </clip>
          </camera>
          <visualize>0</visualize>
          <plugin name="dvs_plugin" filename="libgazebo_dvs_plugin.so">
            <cameraName>front_cam</cameraName>
            <robotNamespace>lane_demo</robotNamespace>
            <eventThreshold>10</eventThreshold>
            <cameraInfoTopicName>camera_info</cameraInfoTopicName>
          </plugin>
        </sensor>

        <plugin name="drive_plugin" filename="libgazebo_ros_planar_move.so">
          <ros>
            <namespace>/lane_demo</namespace>
            <remapping>cmd_vel:=cmd_vel</remapping>
          </ros>
          <bodyName>link</bodyName>
          <topicName>cmd_vel</topicName>
          <odometryTopicName>odom</odometryTopicName>
          <updateRate>100.0</updateRate>
          <linearSpeedGain>1.0</linearSpeedGain>
          <angularSpeedGain>4.0</angularSpeedGain>
        </plugin>
      </link>
    </model>
